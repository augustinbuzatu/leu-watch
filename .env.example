# Copy this file to .env and set your own values: cp .env.example .env
# .env is git-ignored; never commit real credentials.

# PostgreSQL: used by docker-compose.yml to create the database
# and by the Python scripts to connect to it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leu_watch
POSTGRES_USER=leu_watch
POSTGRES_PASSWORD=change-me
